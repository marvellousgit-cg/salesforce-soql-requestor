<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SalesforceClient.ConsoleSample</RootNamespace>
    <AssemblyName>SalesforceClient.ConsoleSample</AssemblyName>
    <!-- Console apps have no SynchronizationContext (CA2007) and a top-level catch-all is intentional (CA1031) -->
    <NoWarn>$(NoWarn);CA2007;CA1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SalesforceClient.Abstractions\SalesforceClient.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\SalesforceClient.Configuration\SalesforceClient.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.jwt-bearer.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
