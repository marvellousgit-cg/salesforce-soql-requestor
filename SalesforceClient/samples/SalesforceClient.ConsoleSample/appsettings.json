{
  "Salesforce": {
    "Auth": {
      // Grant type: "client_credentials" or "jwt-bearer"
      "GrantType": "client_credentials",
      "LoginUrl": "https://login.salesforce.com",
      "ClientId": "<your-connected-app-client-id>",

      // Required for client_credentials only
      "ClientSecret": "<your-client-secret>",

      // Required for jwt-bearer only
      "Username": "",
      "PrivateKeyPath": "",
      "PrivateKeyPem": "",
      "JwtExpirySeconds": 180
    },
    "Connection": {
      "ApiVersion": "v62.0"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "SalesforceClient": "Debug"
    }
  }
}
