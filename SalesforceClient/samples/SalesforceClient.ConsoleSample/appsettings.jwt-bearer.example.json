{
  "Salesforce": {
    "Auth": {
      "GrantType": "jwt-bearer",
      "LoginUrl": "https://login.salesforce.com",
      "ClientId": "<your-connected-app-client-id>",

      // Subject claim — must match a Salesforce user pre-authorised in the connected app.
      "Username": "integration@example.com",

      // Path to a PEM-encoded RSA private key whose public certificate is uploaded to
      // the connected app in Salesforce Setup → App Manager.
      "PrivateKeyPath": "/etc/salesforce/private-key.pem",

      // Alternative to PrivateKeyPath: provide the PEM content inline (useful in containers).
      // "PrivateKeyPem": "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----",

      "JwtExpirySeconds": 180
    },
    "Connection": {
      "ApiVersion": "v62.0"
    }
  }
}
