<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>SalesforceClient.NetCoreForce</RootNamespace>
    <AssemblyName>SalesforceClient.NetCoreForce</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetCoreForce.Client" Version="4.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.9.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SalesforceClient.Abstractions\SalesforceClient.Abstractions.csproj" />
  </ItemGroup>

  <!--
    Grant internal visibility to test projects.
    Using <InternalsVisibleTo> here (rather than a hand-written AssemblyInfo.cs) is the
    canonical SDK idiom: the SDK merges these into the auto-generated AssemblyInfo so there
    is no risk of a conflict between the two files.

    DynamicProxyGenAssembly2 is Castle Windsor's proxy assembly used by Moq at runtime.
    Because this assembly is unsigned, only the name is required — no public key needed.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="SalesforceClient.Tests" />
    <InternalsVisibleTo Include="SalesforceClient.IntegrationTests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
